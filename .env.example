# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (anon key is public; service role is SERVER ONLY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy from Supabase Dashboard → Connect. Do not use localhost.
#
# DATABASE_URL = Transaction pooler (Vercel/serverless only)
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   On Vercel you may append &connection_limit=1 (required for transaction mode).
#
# DIRECT_URL = Session pooler (Prisma migrate, and local next dev / next start)
#   postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#   Do NOT set connection_limit=1 on DIRECT_URL. The app uses a small pool (5) for Node.
# Direct db.[PROJECT_REF].supabase.co is IPv6-only and often does not resolve;
# use the session pooler on port 5432 instead.
DATABASE_URL=
DIRECT_URL=

# Set to 1 to log auth/prisma timings in the server console
# PERF_LOG=

# AES key material for encrypting future integration credentials
ENCRYPTION_KEY=

# Resend transactional email (optional — invites/CRM notifications skip send if unset)
# Server-only. Never expose to the client.
RESEND_API_KEY=
# Verified sender, e.g. "IntraCore <onboarding@resend.dev>" or your domain
RESEND_FROM_EMAIL=

# Bearer secret for /api/v1/jobs/run (background jobs) and /api/health?db=1.
# Generate with: openssl rand -hex 32
CRON_SECRET=

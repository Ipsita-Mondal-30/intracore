generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Identity (id = Supabase auth.users.id) ──────────────────────────────────

model User {
  id                   String    @id @db.Uuid
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  activeOrganizationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships         OrganizationMember[]
  teamMemberships     TeamMember[]
  invitationsSent     Invitation[]         @relation("InvitationInviter")
  auditLogs           AuditLog[]
  notifications       Notification[]
  assignedLeads       Lead[]               @relation("LeadAssignee")
  authoredNotes       LeadNote[]
  assignedTasks       LeadTask[]
  assignedFollowUps   LeadFollowUp[]
  activities          LeadActivity[]
  importJobs          ImportJob[]
  callRecords         LeadCallRecord[]
  transfersFrom       LeadTransfer[]       @relation("TransferFromUser")
  transfersTo         LeadTransfer[]       @relation("TransferToUser")
  transfersBy         LeadTransfer[]       @relation("TransferByUser")
  reengagements       LeadReengagement[]   @relation("ReengagementCreator")
  reengagementsAssigned LeadReengagement[] @relation("ReengagementAssignee")
  communications      LeadCommunication[]
  assignedInquiries   Inquiry[]            @relation("InquiryAssignee")
  conversationParticipants ConversationParticipant[]
  sentMessages        Message[]                 @relation("MessageSender")
  notificationPreferences UserNotificationPreference[]
  assignedWorkTasks   Task[]                    @relation("TaskAssignee")
  createdWorkTasks    Task[]                    @relation("TaskCreator")
  uploadedDocuments   Document[]

  @@map("users")
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  industry     String?
  country      String?
  currency     String   @default("USD")
  timezone     String   @default("UTC")
  contactEmail String?
  contactPhone String?
  /// CRM-wide settings (duplicate matching rules, ...); typed by src/lib/settings.ts
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       OrganizationMember[]
  roles         Role[]
  teams         Team[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  notifications Notification[]
  leadSources   LeadSource[]
  leadProducts  LeadProduct[]
  pipelines     Pipeline[]
  leadStages    LeadStage[]
  leads         Lead[]
  leadTags      LeadTag[]
  leadNotes     LeadNote[]
  leadTasks     LeadTask[]
  leadFollowUps LeadFollowUp[]
  leadActivities LeadActivity[]
  importJobs    ImportJob[]
  leadViews     LeadView[]
  customFieldDefinitions LeadCustomFieldDefinition[]
  customFieldValues LeadCustomFieldValue[]
  callRecords   LeadCallRecord[]
  transfers     LeadTransfer[]
  reengagements LeadReengagement[]
  flagDefinitions LeadFlagDefinition[]
  scoreSnapshots LeadScoreSnapshot[]
  integrations  Integration[]
  communications LeadCommunication[]
  inquiries      Inquiry[]
  conversations Conversation[]
  notificationPreferences UserNotificationPreference[]
  companies     Company[]
  tasks         Task[]
  documents     Document[]
  idempotencyKeys IdempotencyKey[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String       @db.Uuid
  roleId         String
  isOwner        Boolean      @default(false)
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  scopes       MemberScope[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@map("organization_members")
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  roleId          String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String           @db.Uuid
  expiresAt       DateTime
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id])

  @@index([organizationId, email])
  @@index([tokenHash])
  @@index([organizationId])
  @@map("invitations")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  leads        Lead[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  teamId   String
  userId   String   @db.Uuid
  role     String   @default("member")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  companyId      String?
  userId         String?  @db.Uuid
  action         String
  entity         String
  entityId       String?
  previous       Json?
  next           Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([organizationId, companyId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String    @db.Uuid
  type           String
  title          String
  body           String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Leads ───────────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  OPEN
  IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InquiryStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum LeadViewCategory {
  HOME
  ADMISSION
  FLAGGED
  REPORTS
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  DATE
  BOOLEAN
  TEXTAREA
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum CommunicationType {
  WHATSAPP
  EMAIL
  SMS
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
}

enum FollowUpType {
  CALL
  MEETING
  EMAIL
  WHATSAPP
  TASK
  OTHER
}

model LeadSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  isSystem       Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("lead_sources")
}

model LeadProduct {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("lead_products")
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       LeadStage[]
  leads        Lead[]

  @@index([organizationId])
  @@map("pipelines")
}

model LeadStage {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  name           String
  sortOrder      Int
  probability    Int      @default(0)
  color          String?
  isWon          Boolean  @default(false)
  isLost         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId])
  @@index([pipelineId, sortOrder])
  @@map("lead_stages")
}

model Lead {
  id               String       @id @default(cuid())
  organizationId   String
  firstName        String?
  lastName         String?
  fullName         String
  company          String?
  email            String?
  phone            String?
  alternatePhone   String?
  whatsappNumber   String?
  website          String?
  gstNo            String?
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  industry         String?
  jobTitle         String?
  companySize      String?
  requirement      String?
  productInterest  String?
  productId        String?
  expectedValue    Decimal?     @db.Decimal(12, 2)
  budget           String?
  purchaseTimeline String?
  sourceId         String?
  sourceDetail     String?
  campaign         String?
  status           LeadStatus   @default(NEW)
  pipelineId       String?
  stageId          String?
  leadScore        Int          @default(0)
  priority         LeadPriority @default(MEDIUM)
  assignedUserId   String?      @db.Uuid
  assignedTeamId   String?
  description      String?
  lastContactedAt  DateTime?
  nextFollowUpAt   DateTime?
  reEngagedAt      DateTime?
  callbackAt       DateTime?
  lastScoreUpdatedAt DateTime?
  convertedAt      DateTime?
  lostReason       String?
  lostComment      String?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  product      LeadProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  pipeline     Pipeline?    @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage        LeadStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignedUser User?        @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedTeam Team?        @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  tags         LeadTagOnLead[]
  flags        LeadFlagOnLead[]
  notes        LeadNote[]
  tasks        LeadTask[]
  followUps    LeadFollowUp[]
  activities   LeadActivity[]
  callRecords  LeadCallRecord[]
  transfers    LeadTransfer[]
  reengagements LeadReengagement[]
  customFieldValues LeadCustomFieldValue[]
  scoreSnapshots LeadScoreSnapshot[]
  communications LeadCommunication[]
  linkedInquiries Inquiry[]
  conversations Conversation[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, status])
  @@index([organizationId, stageId])
  @@index([organizationId, sourceId])
  @@index([organizationId, productId])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, reEngagedAt])
  @@index([organizationId, callbackAt])
  @@index([organizationId, leadScore])
  @@index([organizationId, archivedAt])
  @@index([organizationId, archivedAt, status])
  @@map("leads")
}

model LeadTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTagOnLead[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("lead_tags")
}

model LeadTagOnLead {
  leadId String
  tagId  String

  lead Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@map("lead_tags_on_leads")
}

model LeadNote {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  authorId       String   @db.Uuid
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId])
  @@map("lead_notes")
}

model LeadTask {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  title          String
  description    String?
  assignedUserId String?      @db.Uuid
  dueDate        DateTime?
  priority       LeadPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId])
  @@index([organizationId, status, dueDate])
  @@map("lead_tasks")
}

model LeadFollowUp {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String
  type           FollowUpType @default(CALL)
  title          String
  description    String?
  dueAt          DateTime
  assignedUserId String?      @db.Uuid
  priority       LeadPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  remindedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId])
  @@index([organizationId, status, dueAt])
  @@index([status, dueAt, remindedAt])
  @@map("lead_follow_ups")
}

model LeadActivity {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  actorId        String?  @db.Uuid
  type           String
  message        String
  previous       Json?
  next           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt])
  @@map("lead_activities")
}

model ImportJob {
  id             String    @id @default(cuid())
  organizationId String
  createdById    String    @db.Uuid
  status         String    @default("COMPLETED")
  filename       String?
  totalRows      Int       @default(0)
  imported       Int       @default(0)
  duplicates     Int       @default(0)
  errors         Int       @default(0)
  failedRows     Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

model LeadView {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  slug               String
  description        String?
  category           LeadViewCategory @default(HOME)
  filters            Json             @default("{}")
  sort               String           @default("createdAt")
  sortDir            String           @default("desc")
  columns            Json             @default("[]")
  isSystem           Boolean          @default(false)
  isActive           Boolean          @default(true)
  sortOrder          Int              @default(0)
  requiredPermission String?
  href               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, category, sortOrder])
  @@map("lead_views")
}

model LeadCustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  key            String
  label          String
  type           CustomFieldType @default(TEXT)
  options        Json?
  section        String          @default("profile")
  sortOrder      Int             @default(0)
  isRequired     Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       LeadCustomFieldValue[]

  @@unique([organizationId, key])
  @@index([organizationId, section, sortOrder])
  @@map("lead_custom_field_definitions")
}

model LeadCustomFieldValue {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  fieldId        String
  value          String?
  valueJson      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field        LeadCustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([organizationId, leadId])
  @@map("lead_custom_field_values")
}

model LeadCallRecord {
  id                   String   @id @default(cuid())
  organizationId       String
  leadId               String
  userId               String   @db.Uuid
  calledAt             DateTime @default(now())
  durationSec          Int?
  phoneNumber          String?
  didNumber            String?
  callType             String   @default("OUTBOUND")
  outcome              String?
  notes                String?
  nextFollowUpAt       DateTime?
  callbackAt           DateTime?
  recordingPath        String?
  recordingFileName    String?
  recordingMimeType    String?
  recordingSizeBytes   Int?
  recordingDurationSec Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, calledAt])
  @@index([organizationId, userId])
  @@map("lead_call_records")
}

model LeadTransfer {
  id              String   @id @default(cuid())
  organizationId  String
  leadId          String
  fromUserId      String?  @db.Uuid
  toUserId        String?  @db.Uuid
  fromTeamId      String?
  toTeamId        String?
  reason          String?
  transferredById String   @db.Uuid
  createdAt       DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUser      User?        @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser        User?        @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  transferredBy User         @relation("TransferByUser", fields: [transferredById], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, toUserId])
  @@map("lead_transfers")
}

model LeadReengagement {
  id               String    @id @default(cuid())
  organizationId   String
  leadId           String
  reengagedAt      DateTime  @default(now())
  reason           String?
  previousStageId  String?
  newStageId       String?
  assignedUserId   String?   @db.Uuid
  nextCallDueAt    DateTime?
  followUpAt       DateTime?
  notes            String?
  createdById      String    @db.Uuid
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("ReengagementAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ReengagementCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, reengagedAt])
  @@map("lead_reengagements")
}

model LeadFlagDefinition {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  label          String
  color          String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadFlagOnLead[]

  @@unique([organizationId, key])
  @@index([organizationId, sortOrder])
  @@map("lead_flag_definitions")
}

model LeadFlagOnLead {
  leadId String
  flagId String

  lead Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  flag LeadFlagDefinition @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@id([leadId, flagId])
  @@map("lead_flags_on_leads")
}

model LeadScoreSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  score          Int
  breakdown      Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@map("lead_score_snapshots")
}

model Inquiry {
  id               String         @id @default(cuid())
  organizationId   String
  subject          String
  description      String?
  contactName      String
  email            String?
  phone            String?
  status           InquiryStatus  @default(OPEN)
  priority         LeadPriority   @default(MEDIUM)
  assignedUserId   String?        @db.Uuid
  linkedLeadId     String?
  source           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("InquiryAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  linkedLead   Lead?        @relation(fields: [linkedLeadId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, createdAt])
  @@index([organizationId, priority])
  @@map("inquiries")
}

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  provider       String
  status         IntegrationStatus @default(DISCONNECTED)
  credentialsRef String?
  metadata       Json?
  lastSyncAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@map("integrations")
}

model LeadCommunication {
  id             String                 @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?                @db.Uuid
  type           CommunicationType
  direction      CommunicationDirection @default(OUTBOUND)
  subject        String?
  bodyPreview    String?
  externalId     String?
  occurredAt     DateTime               @default(now())
  metadata       Json?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, occurredAt])
  @@map("lead_communications")
}

// ─── Chat ────────────────────────────────────────────────────────────────────

enum MessageSender {
  USER
  LEAD
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Conversation {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String
  guestTokenHash String    @unique
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]
  messages       Message[]

  @@unique([organizationId, leadId])
  @@index([organizationId, lastMessageAt])
  @@index([leadId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String    @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderType     MessageSender
  senderUserId   String?       @db.Uuid
  content        String?
  messageType    MessageType   @default(TEXT)
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser   User?               @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  size      Int

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model UserNotificationPreference {
  id                    String  @id @default(cuid())
  organizationId        String
  userId                String  @db.Uuid
  chatMessages          Boolean @default(true)
  leadAssignments       Boolean @default(true)
  followUpReminders     Boolean @default(true)
  taskNotifications     Boolean @default(true)
  systemNotifications   Boolean @default(true)
  browserNotifications  Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("user_notification_preferences")
}

// ─── ERP foundation: companies, branches, scopes ─────────────────────────────
//
// Organization is the tenant. A tenant owns one or more Companies (legal entities,
// each with its own PAN/GSTIN and document numbering). Branches belong to a company
// and may carry their own GSTIN (multi-GSTIN). Company-scoped tables reference
// (organizationId, companyId) -> companies(organizationId, id) so the database
// itself rejects cross-tenant references.

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  legalName      String?
  pan            String?
  gstin          String?
  /// Two-digit GST state code of the registered office, e.g. "29" (Karnataka)
  stateCode      String?
  baseCurrency   String       @default("INR")
  address        String?
  /// Typed by src/lib/settings.ts (approval thresholds, negative stock policy, ...)
  settings       Json         @default("{}")
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches        Branch[]
  memberScopes    MemberScope[]
  numberSequences NumberSequence[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, gstin])
  @@map("companies")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  code           String
  name           String
  gstin          String?
  stateCode      String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company       @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  memberScopes MemberScope[]

  @@unique([companyId, code])
  @@unique([organizationId, id])
  @@unique([organizationId, companyId, id])
  @@index([organizationId, companyId])
  @@map("branches")
}

/// Grants a member access to a company (branchId null = every branch of it).
/// Deny by default: a member without a scope row cannot touch company data.
model MemberScope {
  id             String   @id @default(cuid())
  organizationId String
  memberId       String
  companyId      String
  branchId       String?
  createdAt      DateTime @default(now())

  member  OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Cascade)
  company Company            @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  branch  Branch?            @relation(fields: [organizationId, companyId, branchId], references: [organizationId, companyId, id], onDelete: Cascade)

  @@index([memberId])
  @@index([organizationId, companyId])
  @@map("member_scopes")
}

/// Gapless per-company document numbering, incremented inside the creating transaction.
model NumberSequence {
  id             String   @id @default(cuid())
  organizationId String
  companyId      String
  documentType   String
  prefix         String
  nextNumber     Int      @default(1)
  padding        Int      @default(5)
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("number_sequences")
}

/// Stored responses for retried requests that carry an Idempotency-Key header.
model IdempotencyKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String    @db.Uuid
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Generic to-do / reminder attached to any record via entityType + entityId.
/// Lead tasks and follow-ups keep using LeadTask / LeadFollowUp.
model Task {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String?
  title          String
  description    String?
  entityType     String?
  entityId       String?
  assignedUserId String?      @db.Uuid
  createdById    String       @db.Uuid
  dueAt          DateTime?
  remindAt       DateTime?
  remindedAt     DateTime?
  priority       LeadPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, assignedUserId, status, dueAt])
  @@index([organizationId, entityType, entityId])
  @@index([status, remindAt, remindedAt])
  @@map("tasks")
}

/// Metadata for a file in private storage, attached to any record.
model Document {
  id             String    @id @default(cuid())
  organizationId String
  companyId      String?
  entityType     String
  entityId       String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String    @unique
  uploadedById   String    @db.Uuid
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@map("documents")
}
